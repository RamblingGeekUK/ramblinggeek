---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import RainingTech from '~/components/widgets/RainingTech.astro';
import YouTubeLatestVideos from '~/components/widgets/YouTubeLatestVideos.astro';
const metadata = {
  title: 'RamblingGeek - Wayne Taylor',
  ignoreTitleTemplate: true,
};
---
<Layout metadata={metadata}>
  <RainingTech/>
  <div class="flex min-h-[70vh] items-center justify-center">
    <Hero classes={{ container: 'pb-3' }}>
      <Fragment slot="title">
        {['Hello Friends', 'Hello World', 'Welcome', 'Hey Friends'][Math.floor(Math.random() * 4)]}
      </Fragment>

      <Fragment slot="subtitle">
        <span class="hidden sm:inline">
          <span class="font-semibold">Code. Create. Tinker.</span>
        </span>
      </Fragment>
    </Hero>
  </div>
</Layout>